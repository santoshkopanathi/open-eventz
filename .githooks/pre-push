#!/bin/sh
# Pre-push gate: type-check + unit tests (fast, no browser needed).
# E2E (Playwright) is intentionally CI-ONLY — see .github/workflows/ci.yml (job: e2e).
# It was dropped from this hook because the local chrome-headless-shell binary is often
# missing/mismatched, which produced false push failures and forced --no-verify.
cd "$(git rev-parse --show-toplevel)" || exit 1
echo "▶ pre-push: typecheck + unit tests (E2E runs in CI)"
npm run typecheck && npm test
